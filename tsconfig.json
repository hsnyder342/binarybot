{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@binarybot/core": ["packages/core/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*",
    "packages/**/*",
    "services/**/*"
  ]
}
